rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // A user's profile document and everything beneath it.
    //
    // The nested wildcard covers every per-user collection — bodyMetrics,
    // workoutSessions, exerciseProgress, mileageLogs, dailyMileage,
    // nutritionLogs, coachChat — so adding a collection needs no rules change,
    // and no collection is ever accidentally left world-readable.
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Coach rate-limit counters.
    //
    // Deliberately OUTSIDE the user subtree. Firestore evaluates rules as a
    // permissive union — any matching allow wins — so a `deny` nested under
    // `users/{uid}/{document=**}` would be overridden by the wildcard above and
    // the client could reset its own limit. Only the Cloud Function, which runs
    // with admin credentials and bypasses rules entirely, writes here.
    match /coachUsage/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // What the Coach remembers about the athlete from conversations too old to
    // replay.
    //
    // Outside the user subtree for the same union-of-allows reason as
    // coachUsage above, and the stakes are higher here than for a counter:
    // these lines are injected into the model's context on every turn, so a
    // client that could write them could put words in its own coach's mouth —
    // an invented injury clearance, a fabricated preference. Readable, so the
    // athlete can always see what is being remembered about him.
    match /coachMemory/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Shared program definitions are read-only reference data.
    match /program/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
